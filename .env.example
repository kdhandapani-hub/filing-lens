NEBIUS_API_KEY=
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_CHAT_MODEL=
# Set only if python -m src.check_reasoning shows one of these removes hidden reasoning
NEBIUS_CHAT_EXTRA_BODY=
NEBIUS_REASONING_EFFORT=

PINECONE_API_KEY=
PINECONE_INDEX=week2-financial-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Eval judge (independent of the answer model). Falls back to Nebius if no OpenAI key.
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4.1-mini

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week2-financial-rag

# SEC requires a real name + email in the User-Agent
SEC_USER_AGENT="Your Name you@email.com"
