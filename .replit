modules = ["python-3.12", "nodejs-20", "bash"]
run = "bash build.sh && bash start.sh"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "build.sh"]
run = ["bash", "start.sh"]

[[ports]]
localPort = 8000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "rustc", "xcodebuild", "zlib"]
